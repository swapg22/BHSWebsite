# Local development. Never commit real secrets; .env is git-ignored.
DATABASE_URL=file:./data/bhs.db
PAYLOAD_SECRET=change-me-64-hex-chars
# Used to sign form timestamps, receipt links and demo checkout tokens
APP_SIGNING_SECRET=change-me-64-hex-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: leave blank to use the built-in demo checkout (no money moves)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# Google Calendar (master calendar). Leave blank to use the local calendar only
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Email: leave SMTP blank to capture emails in the CMS "Email outbox" instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@bharathindusamaj.co.uk

# Inbox routing for the contact form
INBOX_GENERAL=secretary@bharathindusamaj.co.uk
INBOX_BOOKINGS=secretary@bharathindusamaj.co.uk
INBOX_DONATIONS=treasurer@bharathindusamaj.co.uk
INBOX_MEMBERSHIP=membership@bharathindusamaj.co.uk
INBOX_SAFEGUARDING=safeguarding@bharathindusamaj.co.uk

# Supabase Postgres (production, section 16). Session pooler connection string from
# Supabase → Project settings → Database → Connection string (session mode, port 5432):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage for uploads (S3 protocol): Project settings → Storage → S3 access keys
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
