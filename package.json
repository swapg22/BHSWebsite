{
  "name": "bharat-hindu-samaj",
  "version": "1.0.0",
  "description": "Bharat Hindu Samaj website: Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "setup": "node scripts/setup.mjs",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx seed/seed.ts",
    "reset": "rm -rf data/bhs.db media && npm run seed",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run tests/unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/int",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "db:migration": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "^3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "exceljs": "^4.4.0",
    "gocardless-nodejs": "^10.12.2",
    "graphql": "^16.8.1",
    "lucide-react": "^1.54.0",
    "next": "16.3.3",
    "otplib": "^13.5.0",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
